# Copy to .env and replace every placeholder. Keep .env uncommitted and chmod 600.

POSTGRES_DB=home_server
POSTGRES_USER=home_server
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DATA_PATH=./postgres/data

# URL-encode the password if it contains URL-reserved characters.
DATABASE_URL=postgresql+asyncpg://home_server:replace-with-a-long-random-password@postgres:5432/home_server
DATABASE_MAX_BYTES=2147483648

MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_CLIENT_ID=home-server-ingestor
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPICS=frigate/events,frigate/reviews,frigate/notifications,frigate/available
MQTT_MAX_INFLIGHT=100

HA_URL=http://homeassistant:8123
HA_TOKEN=replace-with-a-home-assistant-long-lived-access-token
HA_EVENT_TYPES=state_changed,automation_triggered,call_service
HA_HISTORY_MAX_LOOKBACK_SECONDS=900
HA_HISTORY_OVERLAP_SECONDS=5

# The Compose host binding is loopback-only. Inside the container this is
# overridden to 0.0.0.0 so the host loopback mapping can reach the service.
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

RETRY_MAX_ATTEMPTS=8
RETRY_BASE_SECONDS=0.5
RETRY_MAX_DELAY_SECONDS=30

DISK_WARNING_FREE_BYTES=4294967296
DISK_CRITICAL_FREE_BYTES=2147483648
DISK_WARNING_FREE_RATIO=0.20
DISK_CRITICAL_FREE_RATIO=0.10
